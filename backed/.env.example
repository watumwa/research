DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False

# Backend host(s), WITHOUT https://
DJANGO_ALLOWED_HOSTS=YOUR-BACKEND.vercel.app,.vercel.app

# Frontend browser origin(s), WITH https:// and NO trailing slash.
# Separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Optional for preview deployments. Leave blank unless needed.
# Example: ^https://research-frontend-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Must match VITE_GOOGLE_CLIENT_ID in frontend Vercel project.
GOOGLE_OAUTH_CLIENT_ID=
