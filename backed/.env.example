DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False

# Backend host(s), WITHOUT https://
DJANGO_ALLOWED_HOSTS=YOUR-BACKEND.vercel.app,.vercel.app

# Frontend browser origin(s), WITH https:// and NO trailing slash.
# Separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Optional for preview deployments. Leave blank unless needed.
# Example: ^https://research-frontend-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Must match VITE_GOOGLE_CLIENT_ID in frontend Vercel project.
GOOGLE_OAUTH_CLIENT_ID=

# Flutterwave Uganda Mobile Money (backend only; never add these to VITE_* vars)
FLW_SECRET_KEY=FLWSECK_TEST-REPLACE-ME
FLW_SECRET_HASH=replace-with-a-long-random-secret
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_HTTP_TIMEOUT=25

# Optional persistent media storage for Vercel/production.
# Without this, uploaded files are stored only on the local filesystem.
# These variables also work with S3-compatible storage such as Cloudflare R2.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Explicit Uganda Mobile Money payout destination.
# The application creates an auditable payout instruction to this number after every verified sale.
FLW_PAYOUT_MOBILE_NUMBER=256762640590
# Flutterwave's Uganda Mobile Money transfer documentation uses MPS for the account_bank value.
FLW_PAYOUT_BANK_CODE=MPS
FLW_PAYOUT_BENEFICIARY_NAME=Research Skills Payout
# Keep False while testing. Set True only when you want each verified sale to automatically initiate a real payout.
FLW_AUTO_PAYOUT=False
