DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave blank for SQLite development. Example PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/research_blueprint
DATABASE_URL=
FRONTEND_URL=http://localhost:5173

# Password-reset email. Console backend is convenient for development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP production use: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Must match VITE_GOOGLE_CLIENT_ID from frontend/.env
GOOGLE_OAUTH_CLIENT_ID=
